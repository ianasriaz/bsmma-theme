<style>
@keyframes topbarMarquee {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(-50%, 0, 0); }
}
@-webkit-keyframes topbarMarquee {
  0% { -webkit-transform: translate3d(0, 0, 0); }
  100% { -webkit-transform: translate3d(-50%, 0, 0); }
}

.topbar-ticker-wrapper {
  width: 100%;
  overflow: hidden;
  position: relative;
  background-color: #27272a;
}

.topbar-ticker-track {
  display: flex !important;
  width: max-content !important;
  min-width: 200% !important;
  animation: topbarMarquee 20s linear infinite !important;
  -webkit-animation: topbarMarquee 20s linear infinite !important;
  will-change: transform;
}

.topbar-ticker-track:hover {
  animation-play-state: paused !important;
  -webkit-animation-play-state: paused !important;
}

.topbar-ticker-item {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding: 0 1.5rem;
  white-space: nowrap;
}
</style>

<div 
  class="topbar-ticker-wrapper text-white py-2.5 sm:py-3 border-b border-zinc-700/80 shadow-sm relative z-30 cursor-pointer"
  onclick="window.location.href='{{ routes.all_products_collection_url }}'"
  title="Click to explore the latest collection"
>
  <div class="topbar-ticker-track whitespace-nowrap flex items-center">
    
    <!-- Set 1 -->
    <div class="topbar-ticker-item text-xs sm:text-sm md:text-base font-sans font-black uppercase tracking-[0.18em] text-white">
      <span class="inline-flex items-center gap-2">🔥 2026 SUMMER COLLECTION IS NOW LIVE</span>
      <span class="text-accent text-xs">◆</span>
      <span class="inline-flex items-center gap-2">⚡ DAILY NEW ARTICLES ADDED</span>
      <span class="text-accent text-xs">◆</span>
      <span class="inline-flex items-center gap-2">👑 1:1 MASTER LUXURY APPAREL</span>
      <span class="text-accent text-xs">◆</span>
      <span class="inline-flex items-center gap-2">🚚 FREE EXPRESS DELIVERY OVER RS. 5,000</span>
      <span class="text-accent text-xs">◆</span>
      <span class="inline-flex items-center gap-2">✨ PREMIUM TURKEY EDITION</span>
      <span class="text-accent text-xs">◆</span>
    </div>

    <!-- Set 2 (Continuous Loop) -->
    <div class="topbar-ticker-item text-xs sm:text-sm md:text-base font-sans font-black uppercase tracking-[0.18em] text-white" aria-hidden="true">
      <span class="inline-flex items-center gap-2">🔥 2026 SUMMER COLLECTION IS NOW LIVE</span>
      <span class="text-accent text-xs">◆</span>
      <span class="inline-flex items-center gap-2">⚡ DAILY NEW ARTICLES ADDED</span>
      <span class="text-accent text-xs">◆</span>
      <span class="inline-flex items-center gap-2">👑 1:1 MASTER LUXURY APPAREL</span>
      <span class="text-accent text-xs">◆</span>
      <span class="inline-flex items-center gap-2">🚚 FREE EXPRESS DELIVERY OVER RS. 5,000</span>
      <span class="text-accent text-xs">◆</span>
      <span class="inline-flex items-center gap-2">✨ PREMIUM TURKEY EDITION</span>
      <span class="text-accent text-xs">◆</span>
    </div>

  </div>
</div>

