<div 
  class="w-full bg-[#121212] text-zinc-200 py-2 sm:py-2.5 px-4 min-h-[38px] flex items-center justify-center border-b border-zinc-800/40 relative z-30 transition-colors"
  {% if section.settings.link != blank %}
    onclick="window.location.href='{{ section.settings.link }}'"
    role="link"
    tabindex="0"
    style="cursor: pointer;"
  {% endif %}
>
  <div class="w-full max-w-[1400px] mx-auto text-center">
    <p class="text-xs sm:text-sm font-bold tracking-wider text-zinc-100 m-0 select-none uppercase">
      {{ section.settings.announcement_text | default: "Enjoy Free Delivery on Prepaid Orders in Pakistan." }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Enjoy Free Delivery on Prepaid Orders in Pakistan."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name"
    }
  ]
}
{% endschema %}
