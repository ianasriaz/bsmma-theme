{% schema %}
{
  "name": "Luxury Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "HIGH GRADE TURKEY COLLECTION • COMPLIMENTARY EXPRESS DELIVERY OVER RS. 5,000 • VIP LUXURY PACKAGING • HASSLE-FREE EXCHANGES"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111114"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f4f4f5"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Luxury Marquee",
      "category": "Text"
    }
  ]
}
{% endschema %}

<div class="w-full bg-[#0d0d10] border-y border-zinc-800/80 overflow-hidden py-3.5 md:py-4 text-white">
  <div class="marquee-track flex whitespace-nowrap" style="animation: marquee {{ section.settings.speed }}s linear infinite;">
    <div class="flex items-center gap-8 px-6 text-xs md:text-sm font-black uppercase tracking-[0.24em] text-zinc-200">
      <span>{{ section.settings.text }}</span>
      <span class="text-zinc-500 text-xs">✦</span>
      <span>{{ section.settings.text }}</span>
      <span class="text-zinc-500 text-xs">✦</span>
      <span>{{ section.settings.text }}</span>
      <span class="text-zinc-500 text-xs">✦</span>
    </div>
    <div class="flex items-center gap-8 px-6 text-xs md:text-sm font-black uppercase tracking-[0.24em] text-zinc-200" aria-hidden="true">
      <span>{{ section.settings.text }}</span>
      <span class="text-zinc-500 text-xs">✦</span>
      <span>{{ section.settings.text }}</span>
      <span class="text-zinc-500 text-xs">✦</span>
      <span>{{ section.settings.text }}</span>
      <span class="text-zinc-500 text-xs">✦</span>
    </div>
  </div>
</div>

<style>
@keyframes marquee {
  0% { transform: translate3d(0%, 0, 0); }
  100% { transform: translate3d(-50%, 0, 0); }
}
.marquee-track {
  display: flex;
  width: 200%;
  will-change: transform;
}
</style>
