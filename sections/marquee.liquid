{% schema %}
{
  "name": "Luxury Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "HIGH GRADE TURKEY COLLECTION • COMPLIMENTARY EXPRESS DELIVERY OVER RS. 5,000 • VIP LUXURY PACKAGING • HASSLE-FREE EXCHANGES"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111114"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f4f4f5"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Luxury Marquee",
      "category": "Text"
    }
  ]
}
{% endschema %}

<div class="w-full bg-[#111114] border-y border-zinc-800 overflow-hidden py-4 md:py-5 text-white">
  <div class="marquee-track flex whitespace-nowrap" style="animation: marquee {{ section.settings.speed }}s linear infinite;">
    <div class="flex items-center gap-8 px-6 text-sm md:text-base font-black uppercase tracking-[0.2em] text-zinc-100">
      <span>{{ section.settings.text }}</span>
      <span class="text-accent text-sm">◆</span>
      <span>{{ section.settings.text }}</span>
      <span class="text-accent text-sm">◆</span>
      <span>{{ section.settings.text }}</span>
      <span class="text-accent text-sm">◆</span>
    </div>
    <div class="flex items-center gap-8 px-6 text-sm md:text-base font-black uppercase tracking-[0.2em] text-zinc-100" aria-hidden="true">
      <span>{{ section.settings.text }}</span>
      <span class="text-accent text-sm">◆</span>
      <span>{{ section.settings.text }}</span>
      <span class="text-accent text-sm">◆</span>
      <span>{{ section.settings.text }}</span>
      <span class="text-accent text-sm">◆</span>
    </div>
  </div>
</div>

<style>
@keyframes marquee {
  0% { transform: translateX(0%); }
  100% { transform: translateX(-50%); }
}
.marquee-track {
  display: flex;
  width: 200%;
}
</style>
