{% schema %}
{
  "name": "Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subtitle",
      "default": "FRESH ARRIVALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST DROPS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Product Slider",
      "category": "Product"
    }
  ]
}
{% endschema %}

<section class="w-full bg-[#09090b] py-12 md:py-20 border-b border-zinc-800/80">
  <div class="max-w-[1400px] mx-auto px-4 md:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 md:mb-14">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="text-xs md:text-sm font-black uppercase tracking-[0.25em] text-accent block mb-1">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}
        <h2 class="font-display text-3xl md:text-5xl lg:text-6xl font-black uppercase tracking-tight text-white m-0">
          {{ section.settings.heading }}
        </h2>
      </div>

      {% assign target_collection = section.settings.collection %}
      {% if target_collection == blank %}
        {% assign target_collection = collections['all'] %}
      {% endif %}

      {% if target_collection != blank %}
        <a href="{{ target_collection.url }}" class="hidden md:inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-bold text-zinc-400 hover:text-white transition-colors">
          <span>VIEW FULL CATALOG</span>
          <span>→</span>
        </a>
      {% endif %}
    </div>

    <!-- Product Grid Container -->
    <div class="!grid !grid-cols-2 lg:!grid-cols-4 gap-x-4 md:gap-x-6 gap-y-12 md:gap-y-20 pb-4">
      {% if target_collection != blank and target_collection.products_count > 0 %}
        {% for product in target_collection.products limit: section.settings.products_to_show %}
          <div class="w-full">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'portrait',
              show_secondary_image: true,
              show_vendor: true,
              show_rating: false,
              quick_add: 'standard',
              section_id: section.id
            %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Placeholder Fallback -->
        {% for i in (1..section.settings.products_to_show) %}
          <div class="w-full">
            {% render 'card-product',
              card_product: null,
              media_aspect_ratio: 'portrait',
              show_vendor: true,
              placeholder_image: 'product-apparel-2'
            %}
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Mobile View All CTA -->
    {% if target_collection != blank %}
      <div class="flex justify-center mt-6 md:mt-10">
        <a href="{{ target_collection.url }}" class="w-full sm:w-auto text-center inline-flex items-center justify-center px-10 py-4 bg-zinc-900 border border-zinc-700 text-white font-bold uppercase tracking-[0.2em] text-xs md:text-sm rounded-[4px] hover:bg-white hover:text-black hover:border-white transition-all duration-300 shadow-xl">
          VIEW ALL PRODUCTS
        </a>
      </div>
    {% endif %}

  </div>
</section>
