{% schema %}
{
  "name": "Collections Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subtitle",
      "default": "CURATED CAPSULES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Short Tagline",
          "default": "EXPLORE COLLECTION"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image"
        },
        {
          "type": "url",
          "id": "custom_image_url",
          "label": "Custom External Image URL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}

<style>
.luxury-collection-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  width: 100%;
}

/* Mobile: Card 1 is full width with portrait/square aspect ratio */
.luxury-collection-grid > a:first-child {
  grid-column: span 2 / span 2;
  aspect-ratio: 1 / 1;
}

.luxury-collection-grid > a {
  grid-column: span 1 / span 1;
  aspect-ratio: 4 / 5;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  position: relative;
  overflow: hidden;
}

/* Desktop: 6-column grid with 2 - 3 - 2 rhythm and non-cropping tall aspect ratios */
@media (min-width: 768px) {
  .luxury-collection-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px;
  }

  /* 2-card rows (50% width): 1 / 1 or 4 / 5 to showcase full clothing */
  .luxury-collection-grid > a:nth-child(5n + 1),
  .luxury-collection-grid > a:nth-child(5n + 2) {
    grid-column: span 3 / span 3;
    aspect-ratio: 1 / 1;
  }

  /* 3-card rows (33.3% width): 4 / 5 */
  .luxury-collection-grid > a:nth-child(5n + 3),
  .luxury-collection-grid > a:nth-child(5n + 4),
  .luxury-collection-grid > a:nth-child(5n + 5) {
    grid-column: span 2 / span 2;
    aspect-ratio: 4 / 5;
  }
}
</style>

<section class="w-full bg-black py-16 md:py-24 border-b border-zinc-800">
  <div class="max-w-[1400px] mx-auto px-4 md:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 md:mb-16">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="text-sm md:text-base font-black uppercase tracking-[0.25em] text-accent block mb-2">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}
        <h2 class="font-display text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-tight text-white m-0">
          {{ section.settings.heading }}
        </h2>
      </div>
      <span class="hidden md:inline-block text-sm uppercase tracking-[0.2em] text-zinc-400 font-bold">
        DISCOVER ALL CATEGORIES
      </span>
    </div>

    <!-- Editorial Collection Grid -->
    <div class="luxury-collection-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- assign collection = block.settings.collection -%}
          {%- assign custom_image = block.settings.custom_image -%}
          {%- assign custom_image_url = block.settings.custom_image_url -%}
          {%- assign title = block.settings.title | default: collection.title | default: 'Collection' -%}
          {%- assign tagline = block.settings.tagline | default: 'EXPLORE COLLECTION' -%}
          {%- assign link = collection.url | default: block.settings.link | default: '#' -%}

          <a 
            href="{{ link }}" 
            class="group rounded-lg overflow-hidden bg-[#111114] border border-zinc-800 hover:border-zinc-500 transition-all duration-500 shadow-2xl"
            {{ block.shopify_attributes }}
          >
            <!-- Background Image Frame -->
            <div class="absolute inset-0 w-full h-full overflow-hidden bg-zinc-950">
              {% if custom_image_url != blank %}
                <img src="{{ custom_image_url }}" alt="{{ title }}" class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy">
              {% elsif custom_image != blank %}
                {{ custom_image | image_url: width: 1200 | image_tag: class: 'w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105', loading: 'lazy' }}
              {% elsif collection != blank and collection.image != blank %}
                {{ collection.image | image_url: width: 1200 | image_tag: class: 'w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105', loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-40 !fill-zinc-800' }}
              {% endif %}

              <!-- Cinematic Dark Gradient at bottom to keep text legible while showing whole shirt -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent"></div>
            </div>

            <!-- Content Overlay at Bottom -->
            <div class="relative z-10 p-4 sm:p-5 md:p-6 flex items-end justify-between gap-2">
              <div>
                <span class="inline-block text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-accent mb-1 drop-shadow-sm">
                  {{ tagline }}
                </span>
                <h3 class="font-display text-base sm:text-xl md:text-2xl lg:text-3xl font-black text-white uppercase tracking-wider group-hover:text-zinc-200 transition-colors m-0 drop-shadow-md">
                  {{ title }}
                </h3>
              </div>

              <!-- Sleek CTA Icon Pill -->
              <span class="flex-shrink-0 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white/15 backdrop-blur-md border border-white/20 flex items-center justify-center text-white group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-xl">
                <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</section>
