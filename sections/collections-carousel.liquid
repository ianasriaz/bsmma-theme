{% schema %}
{
  "name": "Collections Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Subtitle",
      "default": "CURATED CAPSULES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title Override"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Short Tagline",
          "default": "EXPLORE COLLECTION"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image"
        },
        {
          "type": "url",
          "id": "custom_image_url",
          "label": "Custom External Image URL"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Showcase",
      "category": "Collection"
    }
  ]
}
{% endschema %}

<section class="w-full bg-black py-16 md:py-24 border-b border-zinc-800">
  <div class="max-w-[1400px] mx-auto px-4 md:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 md:mb-14">
      <div>
        {% if section.settings.eyebrow != blank %}
          <span class="text-sm md:text-base font-black uppercase tracking-[0.25em] text-accent block mb-2">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}
        <h2 class="font-display text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-tight text-white m-0">
          {{ section.settings.heading }}
        </h2>
      </div>
      <span class="hidden md:inline-block text-sm uppercase tracking-[0.2em] text-zinc-400 font-bold">
        SWIPE TO DISCOVER →
      </span>
    </div>

    <!-- Category Grid / Carousel -->
    <div class="flex overflow-x-auto snap-x snap-mandatory scrollbar-none gap-5 md:gap-8 pb-6 -mx-4 px-4 md:mx-0 md:px-0" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- assign collection = block.settings.collection -%}
          {%- assign custom_image = block.settings.custom_image -%}
          {%- assign custom_image_url = block.settings.custom_image_url -%}
          {%- assign title = block.settings.title | default: collection.title | default: 'Collection' -%}
          {%- assign tagline = block.settings.tagline | default: 'EXPLORE COLLECTION' -%}
          {%- assign link = collection.url | default: block.settings.link | default: '#' -%}

          <a href="{{ link }}" class="group relative flex-none w-[260px] sm:w-[300px] md:w-[350px] snap-start flex flex-col rounded-lg overflow-hidden bg-[#111114] border border-zinc-800 hover:border-zinc-500 transition-all duration-500 shadow-2xl" {{ block.shopify_attributes }}>
            <!-- Image Frame -->
            <div class="relative w-full aspect-[4/5] overflow-hidden bg-zinc-950">
              {% if custom_image_url != blank %}
                <img src="{{ custom_image_url }}" alt="{{ title }}" class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy">
              {% elsif custom_image != blank %}
                {{ custom_image | image_url: width: 600 | image_tag: class: 'w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105', loading: 'lazy' }}
              {% elsif collection != blank and collection.image != blank %}
                {{ collection.image | image_url: width: 600 | image_tag: class: 'w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105', loading: 'lazy' }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-40 !fill-zinc-800' }}
              {% endif %}

              <!-- Gradient Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent pointer-events-none"></div>

              <!-- Floating Micro-Tag -->
              <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between pointer-events-none">
                <span class="text-xs font-bold tracking-[0.18em] uppercase px-3.5 py-1.5 bg-black/85 backdrop-blur-md border border-white/20 text-white rounded-full shadow-lg">
                  {{ tagline }}
                </span>
                <span class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white group-hover:bg-accent group-hover:text-white transition-colors duration-300 shadow-lg">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>

            <!-- Title Box -->
            <div class="p-5 bg-[#111114] flex items-center justify-between border-t border-zinc-800">
              <h3 class="font-sans text-base sm:text-lg md:text-xl font-bold text-white uppercase tracking-wider group-hover:text-accent transition-colors m-0">
                {{ title }}
              </h3>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>

  </div>
</section>
