{% schema %}
{
  "name": "Custom Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "url",
      "id": "custom_image_url",
      "label": "Custom External Image URL"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HIGH GRADE COPIES • 2026 EDITION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PREMIUM TURKEY APPAREL"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted with 1:1 precision, master fabrics, and unmatched luxury detailing."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Darkness",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "Custom Hero",
      "category": "Image"
    }
  ]
}
{% endschema %}

{%- assign hero_img = section.settings.custom_image_url -%}
{%- if hero_img == blank and section.settings.image != blank -%}
  {%- assign hero_img = section.settings.image | image_url: width: 1800 -%}
{%- endif -%}

<section class="relative w-full min-h-[520px] md:min-h-[640px] lg:min-h-[720px] flex items-center justify-center bg-black overflow-hidden">
  <!-- Background Image with Cinematic Pan/Zoom -->
  {% if hero_img != blank %}
    <div class="absolute inset-0 z-0">
      <img
        src="{{ hero_img }}"
        alt="{{ section.settings.heading }}"
        class="w-full h-full object-cover object-center scale-105 transform motion-reduce:transform-none"
        loading="eager"
      >
      <!-- Luxury Dark Vignette -->
      <div 
        class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-black/30"
        style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
      ></div>
      <div class="absolute inset-0 bg-radial-vignette pointer-events-none opacity-60"></div>
    </div>
  {% endif %}

  <!-- Hero Content Frame -->
  <div class="relative z-10 max-w-[1200px] mx-auto px-6 py-16 md:py-24 text-center flex flex-col items-center">
    
    {% if section.settings.eyebrow != blank %}
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/15 text-zinc-300 text-[10px] md:text-xs font-bold uppercase tracking-[0.25em] mb-4 shadow-lg">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        {{ section.settings.eyebrow }}
      </span>
    {% endif %}

    <h1 class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black uppercase tracking-tight text-white leading-none max-w-4xl drop-shadow-2xl mb-4">
      {{ section.settings.heading }}
    </h1>

    {% if section.settings.subheading != blank %}
      <p class="text-sm md:text-lg text-zinc-300 font-normal max-w-2xl mx-auto mb-8 opacity-90 leading-relaxed">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <!-- Dual Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-3.5 w-full sm:w-auto">
      {% if section.settings.button_label != blank %}
        <a 
          href="{{ section.settings.button_link | default: '/collections/all' }}"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-white text-black font-sans font-bold text-xs md:text-sm uppercase tracking-[0.18em] rounded-[4px] hover:bg-zinc-200 transition-all duration-300 shadow-xl"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}

      {% if section.settings.secondary_button_label != blank %}
        <a 
          href="{{ section.settings.secondary_button_link | default: '/collections/all' }}"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-black/70 backdrop-blur-md text-white border border-white/20 font-sans font-bold text-xs md:text-sm uppercase tracking-[0.18em] rounded-[4px] hover:bg-white hover:text-black transition-all duration-300 shadow-xl"
        >
          {{ section.settings.secondary_button_label }}
        </a>
      {% endif %}
    </div>

  </div>
</section>
