{% schema %}
{
  "name": "Custom Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "url",
      "id": "custom_image_url",
      "label": "Custom External Image URL"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "HIGH GRADE TURKEY COLLECTION • 2026 EDITION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PREMIUM APPAREL"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted with 1:1 precision, master fabrics, and unmatched luxury detailing."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "EXPLORE ALL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Darkness",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Custom Hero",
      "category": "Image"
    }
  ]
}
{% endschema %}

{%- assign hero_img = section.settings.custom_image_url -%}
{%- if hero_img == blank and section.settings.image != blank -%}
  {%- assign hero_img = section.settings.image | image_url: width: 1800 -%}
{%- endif -%}

<section class="relative w-full min-h-[580px] sm:min-h-[660px] md:min-h-[740px] flex items-center justify-center bg-black overflow-hidden py-16 md:py-28">
  <!-- Background Image with Cinematic Depth -->
  {% if hero_img != blank %}
    <div class="absolute inset-0 z-0">
      <img
        src="{{ hero_img }}"
        alt="{{ section.settings.heading }}"
        class="w-full h-full object-cover object-center scale-105"
        loading="eager"
      >
      <!-- Luxury Dark Overlay -->
      <div 
        class="absolute inset-0 bg-gradient-to-t from-black via-black/45 to-black/30"
        style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
      ></div>
      <div class="absolute inset-0 bg-radial-vignette pointer-events-none opacity-50"></div>
    </div>
  {% endif %}

  <!-- Hero Content Frame -->
  <div class="relative z-10 max-w-[1200px] mx-auto px-6 text-center flex flex-col items-center">
    
    {% if section.settings.eyebrow != blank %}
      <span class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-zinc-200 text-xs sm:text-sm font-bold uppercase tracking-[0.2em] mb-6 shadow-xl">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        {{ section.settings.eyebrow }}
      </span>
    {% endif %}

    <h1 class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black uppercase tracking-tight text-white leading-tight max-w-4xl drop-shadow-2xl mb-6">
      {{ section.settings.heading }}
    </h1>

    {% if section.settings.subheading != blank %}
      <p class="text-base sm:text-lg md:text-xl text-zinc-200 font-medium max-w-2xl mx-auto mb-10 leading-relaxed drop-shadow-md">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <!-- Spacious, Bold Dual Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full sm:w-auto">
      {% if section.settings.button_label != blank %}
        <a 
          href="{{ section.settings.button_link | default: '/collections/all' }}"
          class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 sm:px-12 sm:py-5 min-w-[200px] bg-white text-black font-sans font-black text-sm sm:text-base uppercase tracking-[0.2em] rounded-md hover:bg-zinc-200 transition-all duration-300 shadow-2xl border-2 border-white"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}

      {% if section.settings.secondary_button_label != blank %}
        <a 
          href="{{ section.settings.secondary_button_link | default: '/collections/all' }}"
          class="w-full sm:w-auto inline-flex items-center justify-center px-10 py-4 sm:px-12 sm:py-5 min-w-[200px] bg-black/80 backdrop-blur-md text-white border-2 border-white/40 font-sans font-black text-sm sm:text-base uppercase tracking-[0.2em] rounded-md hover:bg-white hover:text-black hover:border-white transition-all duration-300 shadow-2xl"
        >
          {{ section.settings.secondary_button_label }}
        </a>
      {% endif %}
    </div>

  </div>
</section>
